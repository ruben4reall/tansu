          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen triggers: begin met een van deze of voeg je eigen trigger toe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum acionador ainda: comece com um destes ou adicione o seu."
