    "An icon opened from a drawer goes back once its menu has been closed this long.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein aus einer Schublade geöffnetes Symbol kehrt zurück, sobald sein Menü so lange geschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un icono abierto desde un cajón vuelve a él cuando su menú lleva este tiempo cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une icône ouverte depuis un tiroir y retourne une fois ce délai écoulé après la fermeture de son menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’icona aperta da un cassetto vi ritorna quando il suo menu resta chiuso per questo tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き出しから開いたアイコンは、メニューを閉じてからこの時間が経つと引き出しに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서랍에서 연 아이콘은 메뉴가 닫힌 후 이 시간이 지나면 서랍으로 돌아갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een symbool dat vanuit een lade is geopend, gaat terug zodra het menu zo lang gesloten is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ícone aberto de uma gaveta volta para ela quando o menu fica fechado por esse tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从抽屉中打开的图标会在其菜单关闭达到此时长后放回抽屉。"
          }
        }
      }
    },
