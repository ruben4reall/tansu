    "macOS 26: Tansu moves icons behind an invisible divider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 26: Tansu bewegt Symbole hinter eine unsichtbare Trennlinie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 26: Tansu mueve los iconos detrás de un separador invisible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 26 : Tansu déplace les icônes derrière un séparateur invisible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 26: Tansu sposta le icone dietro un separatore invisibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 26: Tansuが見えない区切りの後ろにアイコンを移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
