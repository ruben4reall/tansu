    "No profiles yet. Save your current setup to come back to it in one click, from Tansu's menu or a shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Profile. Sichere deine aktuelle Konfiguration, um mit einem Klick zu ihr zurückzukehren, über das Menü von Tansu oder einen Tastaturkurzbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay perfiles. Guarda tu configuración actual para volver a ella con un clic, desde el menú de Tansu o con un atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun profil pour l’instant. Enregistrez votre configuration actuelle pour y revenir en un clic, depuis le menu de Tansu ou avec un raccourci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun profilo. Salva la configurazione attuale per tornarci con un clic, dal menu di Tansu o con un’abbreviazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen profielen. Bewaar je huidige configuratie om er met één klik naar terug te gaan, via het menu van Tansu of een toetscombinatie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum perfil ainda. Salve a configuração atual para voltar a ela com um clique, pelo menu do Tansu ou por um atalho."
          }
        }
      }
    },
    "No triggers yet: start from one of these, or add your own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Auslöser: Beginne mit einem dieser Beispiele oder füge einen eigenen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay activadores: empieza con uno de estos o añade el tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun déclencheur pour l’instant : partez de l’un de ceux-ci, ou ajoutez le vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun attivatore: parti da uno di questi o aggiungine uno tuo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen triggers: begin met een van deze of voeg je eigen trigger toe."
