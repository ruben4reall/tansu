            "state": "translated",
            "value": "%lld iconos no caben junto al notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld icônes ne tiennent pas à côté de l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld icone non entrano accanto al notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld symbolen passen niet naast de notch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ícones não cabem ao lado do notch."
          }
        }
