            "value": "Modalità Focus quando Keynote è in primo piano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Keynoteが最前面にあるときはフォーカスモード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Keynote가 맨 앞에 있을 때 포커스 모드 켜기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
