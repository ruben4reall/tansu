    "Only on empty room: the icons and the app's menus keep their clicks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf freier Fläche: Symbole und App-Menüs reagieren weiterhin auf Klicks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en el espacio vacío: los iconos y los menús de la app siguen recibiendo sus clics."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement sur un espace vide : les icônes et les menus de l’app gardent leurs clics."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo sullo spazio vuoto: le icone e i menu dell’app continuano a ricevere i clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いている場所でのみ反応します。アイコンやアプリのメニューのクリックはそのまま使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 공간에서만 작동합니다. 아이콘과 앱 메뉴는 평소처럼 클릭할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen op lege ruimte: de symbolen en de appmenu's blijven op klikken reageren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só em espaço vazio: os ícones e os menus do app continuam recebendo os cliques."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限空白处：图标和App菜单仍可正常点按。"
          }
        }
      }
    },
