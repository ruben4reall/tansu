    "Reset your layout? Every icon goes back to the menu bar and Tansu shows its welcome again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Layout zurücksetzen? Alle Symbole kehren in die Menüleiste zurück und Tansu zeigt erneut die Begrüßung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer tu disposición? Todos los iconos vuelven a la barra de menús y Tansu vuelve a mostrar la bienvenida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialiser votre disposition ? Toutes les icônes retournent dans la barre des menus et Tansu affiche à nouveau son accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizializzare il layout? Tutte le icone tornano nella barra dei menu e Tansu mostra di nuovo il benvenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトをリセットしますか? すべてのアイコンがメニューバーに戻り、Tansuのようこそ画面が再び表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃을 재설정하겠습니까? 모든 아이콘이 메뉴 막대로 돌아가고 Tansu의 시작 화면이 다시 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lay-out opnieuw instellen? Alle symbolen gaan terug naar de menubalk en Tansu toont het welkomstscherm opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redefinir seu layout? Todos os ícones voltam para a barra de menus e o Tansu mostra as boas-vindas novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要还原布局吗？所有图标都将回到菜单栏，Tansu会再次显示欢迎界面。"
          }
        }
      }
    },
