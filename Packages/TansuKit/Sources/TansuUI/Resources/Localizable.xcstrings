    "Delete the profile “%@”? The menu bar stays as it is now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil „%@“ löschen? Die Menüleiste bleibt, wie sie ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar el perfil “%@”? La barra de menús se queda como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le profil « %@ » ? La barre des menus reste telle qu’elle est."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare il profilo “%@”? La barra dei menu resta com’è ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル“%@”を削除しますか? メニューバーは現在のまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 프로필을 삭제하겠습니까? 메뉴 막대는 현재 상태로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiel '%@' verwijderen? De menubalk blijft zoals hij nu is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o perfil “%@”? A barra de menus fica como está."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除场景“%@”吗？菜单栏会保持当前状态。"
          }
        }
      }
    },
    "Delete this trigger?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Auslöser löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este activador?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce déclencheur ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questo attivatore?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトリガーを削除しますか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 트리거를 삭제하겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze trigger verwijderen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar este acionador?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除此触发器吗？"
          }
        }
      }
    },
    "Delete “%@”? Its icons go back to the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ löschen? Ihre Symbole kehren in die Menüleiste zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar “%@”? Sus iconos vuelven a la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ » ? Ses icônes retournent dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare “%@”? Le sue icone tornano nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”を削除しますか? 中のアイコンはメニューバーに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 삭제하겠습니까? 서랍의 아이콘은 메뉴 막대로 돌아갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' verwijderen? De symbolen gaan terug naar de menubalk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar “%@”? Os ícones dela voltam para a barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除“%@”吗？其中的图标将回到菜单栏。"
          }
        }
      }
    },
    "Demo: generic icons, nothing in your menu bar moves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: allgemeine Symbole, in deiner Menüleiste bewegt sich nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: iconos genéricos, nada se mueve en tu barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démo : des icônes génériques, rien ne bouge dans votre barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: icone generiche, nulla si sposta nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモ: 汎用アイコンを使用し、メニューバーの項目は移動しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데모: 일반 아이콘을 사용하며, 메뉴 막대의 항목은 움직이지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo: algemene symbolen, er verandert niets in je menubalk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Demonstração: ícones genéricos, nada se move na sua barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示：使用通用图标，菜单栏中的项目不会移动。"
          }
        }
      }
    },
