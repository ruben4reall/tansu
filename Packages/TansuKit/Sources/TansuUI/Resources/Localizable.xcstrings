    "Focus is on: only the clock and Control Center show. Click to end it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus ist aktiv: Nur die Uhr und das Kontrollzentrum werden angezeigt. Zum Beenden klicken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo Focus está activado: solo se muestran el reloj y el centro de control. Haz clic para salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode Focus est activé : seuls l’horloge et le centre de contrôle sont affichés. Cliquez pour le quitter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità Focus è attiva: vengono mostrati solo l’orologio e Centro di Controllo. Fai clic per uscire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus staat aan: alleen de klok en het bedieningspaneel worden getoond. Klik om te beëindigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Modo Focus está ativado: somente o relógio e a Central de Controle aparecem. Clique para sair."
          }
        }
      }
    },
    "Focus while Keynote is in front": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus, wenn Keynote im Vordergrund ist"
          }
        },
        "es": {
