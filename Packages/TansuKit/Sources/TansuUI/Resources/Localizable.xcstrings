    "Drag an icon to another drawer. Click a drawer's own icon to change it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe ein Symbol in eine andere Schublade. Klicke auf das Symbol einer Schublade, um es zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un icono a otro cajón. Haz clic en el icono de un cajón para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une icône vers un autre tiroir. Cliquez sur l’icône d’un tiroir pour la changer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un’icona in un altro cassetto. Fai clic sull’icona di un cassetto per cambiarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンをほかの引き出しにドラッグできます。引き出しのアイコンをクリックすると変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 다른 서랍으로 드래그하십시오. 서랍 아이콘을 클릭하면 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een symbool naar een andere lade. Klik op het symbool van een lade om het te wijzigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um ícone para outra gaveta. Clique no ícone de uma gaveta para alterá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将图标拖到另一个抽屉。点按抽屉的图标可更改它。"
          }
        }
      }
    },
    "Drag icons between the menu bar, your drawers and Hidden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Symbole zwischen der Menüleiste, deinen Schubladen und „Ausgeblendet“ hin und her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra iconos entre la barra de menús, tus cajones y “Ocultos”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les icônes entre la barre des menus, vos tiroirs et « Masquées »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina le icone tra la barra dei menu, i tuoi cassetti e “Nascoste”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー、引き出し、“非表示”の間でアイコンをドラッグします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대, 서랍, ‘가려진 항목’ 사이에서 아이콘을 드래그하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep symbolen tussen de menubalk, je laden en 'Verborgen'."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste ícones entre a barra de menus, suas gavetas e “Ocultos”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏、抽屉和“已隐藏”之间拖移图标。"
          }
        }
      }
    },
    "Drag icons into it in Settings, Layout.": {
      "localizations": {
        "de": {
          "stringUnit": {
