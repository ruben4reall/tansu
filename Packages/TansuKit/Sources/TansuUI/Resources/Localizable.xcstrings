            "state": "translated",
            "value": "In macOS 27 kunnen alleen apps in de map 'Apps' de menubalk wijzigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS 27 só permite que os apps da pasta Aplicativos alterem a barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在macOS 27中，只有“应用程序”文件夹中的App可以更改菜单栏。"
          }
        }
      }
    },
    "macOS 27: Tansu asks macOS to hide whole apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27: Tansu bittet macOS, ganze Apps auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27: Tansu pide a macOS que oculte apps completas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27 : Tansu demande à macOS de masquer des apps entières."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27: Tansu chiede a macOS di nascondere intere app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27: TansuがmacOSにアプリ単位での非表示を依頼します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27: Tansu가 macOS에 앱 단위로 가리도록 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27: Tansu vraagt macOS om hele apps te verbergen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27: o Tansu pede ao macOS para ocultar apps inteiros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27：Tansu会请求macOS隐藏整个App。"
          }
        }
      }
    },
    "macOS keeps the clock and Control Center in place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lässt die Uhr und das Kontrollzentrum an ihrem Platz."
          }
        },
