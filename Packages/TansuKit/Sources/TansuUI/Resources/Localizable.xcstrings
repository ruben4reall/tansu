          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld symbolen verdwijnen uit de menubalk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ícones saem da barra de menus."
          }
        }
