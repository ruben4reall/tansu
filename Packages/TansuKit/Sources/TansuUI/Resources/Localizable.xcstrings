            "value": "此抽屉为空。"
          }
        }
      }
    },
    "This file comes from a newer version of Tansu. Update Tansu, then import it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei stammt aus einer neueren Version von Tansu. Aktualisiere Tansu und importiere sie dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo procede de una versión más reciente de Tansu. Actualiza Tansu y vuelve a importarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier provient d’une version plus récente de Tansu. Mettez Tansu à jour, puis importez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file proviene da una versione più recente di Tansu. Aggiorna Tansu, poi importalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは新しいバージョンのTansuで作成されました。Tansuをアップデートしてから、もう一度読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 최신 버전의 Tansu에서 만든 것입니다. Tansu를 업데이트한 다음 다시 가져오십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand komt van een nieuwere versie van Tansu. Werk Tansu bij en importeer het daarna opnieuw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo é de uma versão mais recente do Tansu. Atualize o Tansu e importe-o novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件来自更高版本的Tansu。请更新Tansu，然后再次导入。"
          }
        }
      }
    },
    "This file is not a Tansu settings file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist keine Einstellungsdatei von Tansu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no es un archivo de ajustes de Tansu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas un fichier de réglages Tansu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è un file di impostazioni di Tansu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはTansuの設定ファイルではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 Tansu 설정 파일이 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand is geen instellingenbestand van Tansu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não é um arquivo de ajustes do Tansu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不是Tansu设置文件。"
          }
        }
      }
    },
    "This version of macOS changed what Tansu relies on (%@). Everything stays in the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese macOS-Version hat geändert, worauf Tansu angewiesen ist (%@). Alles bleibt in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de macOS ha cambiado algo de lo que depende Tansu (%@). Todo se queda en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de macOS a modifié ce sur quoi Tansu s’appuie (%@). Tout reste dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di macOS ha modificato ciò su cui si basa Tansu (%@). Tutto resta nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのmacOSでは、Tansuが利用している機能が変更されています（%@）。すべてのアイコンはメニューバーに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전의 macOS에서 Tansu가 사용하는 기능이 변경되었습니다(%@). 모든 항목이 메뉴 막대에 그대로 남습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie van macOS heeft gewijzigd waar Tansu op steunt (%@). Alles blijft in de menubalk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do macOS alterou algo de que o Tansu depende (%@). Tudo fica na barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的macOS更改了Tansu所依赖的功能（%@）。所有项目都会留在菜单栏中。"
          }
        }
      }
    },
