    "In System Settings, turn on Tansu under Privacy & Security, Accessibility.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Tansu in den Systemeinstellungen im Bereich „Datenschutz & Sicherheit“ unter „Bedienungshilfen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del Sistema, activa Tansu en Privacidad y seguridad > Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages Système, activez Tansu sous Confidentialité et sécurité > Accessibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Impostazioni di Sistema, attiva Tansu in Privacy e sicurezza > Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定の“プライバシーとセキュリティ”＞“アクセシビリティ”で、Tansuをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정의 ‘개인정보 보호 및 보안’, ‘손쉬운 사용’에서 Tansu를 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Tansu in Systeeminstellingen in onder 'Privacy en beveiliging' > 'Toegankelijkheid'."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos Ajustes do Sistema, ative o Tansu em Privacidade e Segurança > Acessibilidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”中“隐私与安全性”的“辅助功能”下打开Tansu。"
          }
        }
      }
    },
