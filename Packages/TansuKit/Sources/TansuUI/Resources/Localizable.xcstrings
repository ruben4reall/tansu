    "When the condition ends, the profile you had before comes back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Bedingung endet, kehrt das vorherige Profil zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la condición termina, vuelve el perfil que tenías antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la condition prend fin, le profil précédent revient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la condizione termina, torna il profilo precedente."
          }
        }
