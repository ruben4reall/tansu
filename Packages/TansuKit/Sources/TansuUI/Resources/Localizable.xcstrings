            "value": "1 ícone não cabe ao lado do notch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有1个图标在刘海旁放不下。"
          }
        }
      }
    },
    "1 icon leaves the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Symbol verlässt die Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 icono sale de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 icône quitte la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 icona esce dalla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1個のアイコンがメニューバーから外れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 1개가 메뉴 막대에서 빠집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1 symbool verdwijnt uit de menubalk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ícone sai da barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1个图标将移出菜单栏。"
          }
        }
      }
    },
    "A file to keep a copy, or to set up another Mac the same way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei, um eine Kopie aufzubewahren oder einen anderen Mac genauso einzurichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo para guardar una copia o para configurar otro Mac de la misma forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier pour en garder une copie, ou pour configurer un autre Mac de la même façon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file per conservarne una copia o per configurare un altro Mac allo stesso modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーを保管したり、別のMacを同じように設定したりするためのファイルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사본을 보관하거나 다른 Mac을 같은 방식으로 설정하기 위한 파일입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bestand om een kopie te bewaren of om een andere Mac op dezelfde manier in te stellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo para guardar uma cópia ou para configurar outro Mac da mesma forma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于保留副本，或以相同方式设置另一台Mac的文件。"
          }
        }
      }
    },
    "A place for every icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Platz für jedes Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lugar para cada icono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une place pour chaque icône."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un posto per ogni icona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアイコンにも居場所を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 아이콘에 자리를."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een plek voor elk symbool."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lugar para cada ícone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个图标，各得其所。"
          }
        }
      }
    },
    "A profile keeps a whole setup of the menu bar: its drawers, where each icon goes, and the appearance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil speichert eine komplette Konfiguration der Menüleiste: ihre Schubladen, den Platz jedes Symbols und das Erscheinungsbild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil guarda una configuración completa de la barra de menús: sus cajones, dónde va cada icono y el aspecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profil conserve toute une configuration de la barre des menus : ses tiroirs, la place de chaque icône et l’apparence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profilo conserva un’intera configurazione della barra dei menu: i cassetti, la posizione di ogni icona e l’aspetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルには、メニューバーの構成全体（引き出し、各アイコンの配置、外観）が保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필은 메뉴 막대의 전체 구성(서랍, 각 아이콘의 위치, 모양)을 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een profiel bewaart een volledige configuratie van de menubalk: de laden, de plek van elk symbool en de weergave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um perfil guarda toda uma configuração da barra de menus: as gavetas, o lugar de cada ícone e a aparência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "场景会保存菜单栏的整套配置：抽屉、每个图标的位置和外观。"
          }
        }
      }
    },
    "A range can cross midnight: from %@ to %@, for instance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zeitraum kann über Mitternacht reichen: zum Beispiel von %@ bis %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un intervalo puede pasar de la medianoche: por ejemplo, de %@ a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une plage peut passer minuit : de %@ à %@, par exemple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un intervallo può superare la mezzanotte: ad esempio dalle %@ alle %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間帯は午前0時をまたいでも構いません（例: %@から%@まで）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 범위는 자정을 넘겨도 됩니다. 예: %@부터 %@까지."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een periode mag over middernacht gaan: bijvoorbeeld van %@ tot %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um intervalo pode passar da meia-noite: por exemplo, das %@ às %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间范围可以跨越午夜，例如从%@到%@。"
          }
        }
      }
    },
    "A shortcut opens an icon's menu, wherever the icon lives.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tastaturkurzbefehl öffnet das Menü eines Symbols, egal wo sich das Symbol befindet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo de teclado abre el menú de un icono, esté donde esté."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raccourci ouvre le menu d’une icône, où qu’elle se trouve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’abbreviazione apre il menu di un’icona, ovunque si trovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを押すと、アイコンがどこにあってもそのメニューが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 사용하면 아이콘이 어디에 있든 해당 아이콘의 메뉴가 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een toetscombinatie opent het menu van een symbool, waar het symbool zich ook bevindt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um atalho abre o menu de um ícone, onde quer que ele esteja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论图标位于何处，快捷键都能打开它的菜单。"
          }
        }
      }
    },
    "A trigger changes the menu bar while something is true, and puts it back when it no longer is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Auslöser ändert die Menüleiste, solange eine Bedingung zutrifft, und stellt sie wieder her, sobald sie nicht mehr zutrifft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un activador cambia la barra de menús mientras se cumple una condición y la restablece cuando deja de cumplirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un déclencheur modifie la barre des menus tant qu’une condition est remplie, puis la rétablit dès qu’elle ne l’est plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un attivatore modifica la barra dei menu finché una condizione è vera e la ripristina quando non lo è più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガーは、条件が満たされている間メニューバーを変更し、条件が満たされなくなると元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거는 조건이 충족되는 동안 메뉴 막대를 변경하고, 조건이 더 이상 충족되지 않으면 원래대로 되돌립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een trigger wijzigt de menubalk zolang een voorwaarde geldt en zet hem terug zodra die niet meer geldt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um acionador altera a barra de menus enquanto uma condição for verdadeira e a restaura quando ela deixar de ser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发器会在条件成立时更改菜单栏，并在条件不再成立时将其复原。"
          }
        }
      }
    },
