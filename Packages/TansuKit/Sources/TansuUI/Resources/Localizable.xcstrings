          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allora"
          }
        }
      }
    },
    "They join Other as soon as the room runs out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wandern in die Schublade „Sonstiges“, sobald der Platz nicht mehr reicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasan al cajón “Otros” en cuanto se acaba el espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles rejoignent le tiroir « Autres » dès que la place manque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finiscono nel cassetto “Altro” non appena lo spazio si esaurisce."
          }
        }
      }
    },
    "This drawer is empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Schublade ist leer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cajón está vacío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tiroir est vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo cassetto è vuoto."
          }
        }
      }
    },
    "This file comes from a newer version of Tansu. Update Tansu, then import it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei stammt aus einer neueren Version von Tansu. Aktualisiere Tansu und importiere sie dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo procede de una versión más reciente de Tansu. Actualiza Tansu y vuelve a importarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier provient d’une version plus récente de Tansu. Mettez Tansu à jour, puis importez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file proviene da una versione più recente di Tansu. Aggiorna Tansu, poi importalo di nuovo."
          }
        }
      }
    },
    "This file is not a Tansu settings file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist keine Einstellungsdatei von Tansu."
          }
        },
