    "A file to keep a copy, or to set up another Mac the same way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei, um eine Kopie aufzubewahren oder einen anderen Mac genauso einzurichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo para guardar una copia o para configurar otro Mac de la misma forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier pour en garder une copie, ou pour configurer un autre Mac de la même façon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file per conservarne una copia o per configurare un altro Mac allo stesso modo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bestand om een kopie te bewaren of om een andere Mac op dezelfde manier in te stellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo para guardar uma cópia ou para configurar outro Mac da mesma forma."
          }
        }
      }
    },
    "A place for every icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Platz für jedes Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lugar para cada icono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une place pour chaque icône."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un posto per ogni icona."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een plek voor elk symbool."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lugar para cada ícone."
          }
        }
      }
    },
    "A profile keeps a whole setup of the menu bar: its drawers, where each icon goes, and the appearance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil speichert eine komplette Konfiguration der Menüleiste: ihre Schubladen, den Platz jedes Symbols und das Erscheinungsbild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil guarda una configuración completa de la barra de menús: sus cajones, dónde va cada icono y el aspecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profil conserve toute une configuration de la barre des menus : ses tiroirs, la place de chaque icône et l’apparence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profilo conserva un’intera configurazione della barra dei menu: i cassetti, la posizione di ogni icona e l’aspetto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een profiel bewaart een volledige configuratie van de menubalk: de laden, de plek van elk symbool en de weergave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um perfil guarda toda uma configuração da barra de menus: as gavetas, o lugar de cada ícone e a aparência."
          }
        }
      }
    },
    "A range can cross midnight: from %@ to %@, for instance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zeitraum kann über Mitternacht reichen: zum Beispiel von %@ bis %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un intervalo puede pasar de la medianoche: por ejemplo, de %@ a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une plage peut passer minuit : de %@ à %@, par exemple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un intervallo può superare la mezzanotte: ad esempio dalle %@ alle %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een periode mag over middernacht gaan: bijvoorbeeld van %@ tot %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um intervalo pode passar da meia-noite: por exemplo, das %@ às %@."
          }
        }
      }
    },
    "A shortcut opens an icon's menu, wherever the icon lives.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tastaturkurzbefehl öffnet das Menü eines Symbols, egal wo sich das Symbol befindet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo de teclado abre el menú de un icono, esté donde esté."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un raccourci ouvre le menu d’une icône, où qu’elle se trouve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’abbreviazione apre il menu di un’icona, ovunque si trovi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een toetscombinatie opent het menu van een symbool, waar het symbool zich ook bevindt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um atalho abre o menu de um ícone, onde quer que ele esteja."
          }
        }
      }
    },
    "A trigger changes the menu bar while something is true, and puts it back when it no longer is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Auslöser ändert die Menüleiste, solange eine Bedingung zutrifft, und stellt sie wieder her, sobald sie nicht mehr zutrifft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un activador cambia la barra de menús mientras se cumple una condición y la restablece cuando deja de cumplirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un déclencheur modifie la barre des menus tant qu’une condition est remplie, puis la rétablit dès qu’elle ne l’est plus."
          }
        },
        "it": {
