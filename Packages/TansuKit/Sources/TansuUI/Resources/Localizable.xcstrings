    "Tansu could not move %@. Try again, or move it with Command-drag.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu konnte %@ nicht bewegen. Versuche es erneut oder ziehe das Symbol mit gedrückter Command-Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu no ha podido mover %@. Vuelve a intentarlo o arrástralo con la tecla Comando pulsada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu n’a pas pu déplacer %@. Réessayez, ou déplacez l’icône en la faisant glisser avec la touche Commande enfoncée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu non riesce a spostare %@. Riprova, oppure sposta l’icona trascinandola con il tasto Comando premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansuは%@を移動できませんでした。もう一度試すか、Commandキーを押しながらドラッグして移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu가 %@을(를) 이동할 수 없습니다. 다시 시도하거나 Command-드래그로 이동하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu kon %@ niet verplaatsen. Probeer het opnieuw of sleep het symbool met de Command-toets ingedrukt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu não conseguiu mover %@. Tente novamente ou arraste o ícone com a tecla Command pressionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu无法移动%@。请重试，或按住Command键拖移它。"
          }
        }
      }
    },
    "Tansu could not open %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu konnte %@ nicht öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu no ha podido abrir %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu n’a pas pu ouvrir %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu non riesce ad aprire %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansuは%@を開けませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu가 %@을(를) 열 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu kon %@ niet openen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu não conseguiu abrir %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu无法打开%@。"
          }
        }
      }
    },
    "Tansu does not see any icon to sort yet. Your drawers will fill as apps add theirs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu sieht noch keine Symbole zum Einsortieren. Deine Schubladen füllen sich, sobald Apps ihre Symbole hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu aún no ve ningún icono que organizar. Tus cajones se llenarán a medida que las apps añadan los suyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu ne voit encore aucune icône à ranger. Vos tiroirs se rempliront à mesure que les apps ajouteront les leurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu non vede ancora nessuna icona da riordinare. I cassetti si riempiranno man mano che le app aggiungeranno le loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansuには整理できるアイコンがまだ見つかりません。アプリがアイコンを追加すると、引き出しに入っていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu가 아직 정리할 아이콘을 찾지 못했습니다. 앱이 아이콘을 추가하면 서랍이 채워집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu ziet nog geen symbolen om te sorteren. Je laden vullen zich zodra apps hun symbolen toevoegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu ainda não vê nenhum ícone para organizar. Suas gavetas vão se encher à medida que os apps adicionarem os deles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu尚未发现可整理的图标。App添加图标后，抽屉就会逐渐填满。"
          }
        }
      }
    },
    "Tansu found %lld icons. Here is a tidier menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu hat %lld Symbole gefunden. Hier ist eine aufgeräumtere Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu ha encontrado %lld iconos. Aquí tienes una barra de menús más ordenada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu a trouvé %lld icônes. Voici une barre des menus mieux rangée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu ha trovato %lld icone. Ecco una barra dei menu più ordinata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansuは%lld個のアイコンを見つけました。整理したメニューバーはこちらです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu가 아이콘 %lld개를 찾았습니다. 더 깔끔해진 메뉴 막대입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu heeft %lld symbolen gevonden. Hier is een opgeruimdere menubalk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu encontrou %lld ícones. Aqui está uma barra de menus mais organizada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu找到了%lld个图标。这是整理后的菜单栏。"
          }
        }
      }
    },
    "Tansu is not affiliated with Apple.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu steht in keiner Verbindung zu Apple."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu no tiene ninguna vinculación con Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu n’est pas affilié à Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu non ha alcuna affiliazione con Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TansuはAppleとは関係ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu는 Apple과 제휴 관계가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu is niet gelieerd aan Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu não tem vínculo com a Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu与Apple无关联。"
          }
        }
      }
    },
    "Tansu needs Accessibility to open icons.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu benötigt Zugriff auf die Bedienungshilfen, um Symbole zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu necesita acceso a Accesibilidad para abrir los iconos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu a besoin de l’autorisation Accessibilité pour ouvrir les icônes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu ha bisogno dell’accesso ad Accessibilità per aprire le icone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを開くには、Tansuにアクセシビリティへのアクセスを許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 열려면 Tansu에 손쉬운 사용 접근 권한이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu heeft toegang tot 'Toegankelijkheid' nodig om symbolen te openen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu precisa de acesso à Acessibilidade para abrir os ícones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu需要辅助功能访问权限才能打开图标。"
          }
        }
      }
    },
    "Tansu needs Accessibility to see and arrange your icons.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu benötigt Zugriff auf die Bedienungshilfen, um deine Symbole zu sehen und anzuordnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu necesita acceso a Accesibilidad para ver y organizar tus iconos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu a besoin de l’autorisation Accessibilité pour voir et ranger vos icônes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu ha bisogno dell’accesso ad Accessibilità per vedere e disporre le tue icone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを認識して並べ替えるには、Tansuにアクセシビリティへのアクセスを許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 확인하고 정렬하려면 Tansu에 손쉬운 사용 접근 권한이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu heeft toegang tot 'Toegankelijkheid' nodig om je symbolen te zien en te rangschikken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu precisa de acesso à Acessibilidade para ver e organizar seus ícones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu需要辅助功能访问权限才能查看和排列你的图标。"
          }
        }
      }
    },
    "Tansu needs Accessibility to see which app owns each icon and to open them for you. It never records your screen and never goes online, except to check for updates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu benötigt Zugriff auf die Bedienungshilfen, um zu sehen, zu welcher App jedes Symbol gehört, und um Symbole für dich zu öffnen. Tansu zeichnet niemals deinen Bildschirm auf und geht nie online, außer um nach Updates zu suchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu necesita acceso a Accesibilidad para saber a qué app pertenece cada icono y para abrirlos por ti. Nunca graba tu pantalla ni se conecta a internet, salvo para buscar actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu a besoin de l’autorisation Accessibilité pour savoir à quelle app appartient chaque icône et pour les ouvrir à votre place. Il n’enregistre jamais votre écran et ne se connecte jamais à Internet, sauf pour rechercher des mises à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu ha bisogno dell’accesso ad Accessibilità per sapere a quale app appartiene ogni icona e per aprirle al posto tuo. Non registra mai lo schermo e non si connette mai a internet, se non per verificare gli aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アイコンがどのアプリのものかを調べてアイコンを開くために、Tansuにはアクセシビリティへのアクセスが必要です。画面を収録することはなく、アップデートの確認以外でインターネットに接続することもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 아이콘이 어느 앱의 것인지 확인하고 대신 열어 주려면 Tansu에 손쉬운 사용 접근 권한이 필요합니다. Tansu는 화면을 기록하지 않으며, 업데이트 확인 외에는 인터넷에 연결하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu heeft toegang tot 'Toegankelijkheid' nodig om te zien bij welke app elk symbool hoort en om symbolen voor je te openen. Tansu neemt nooit je scherm op en gaat nooit online, behalve om naar updates te zoeken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu precisa de acesso à Acessibilidade para saber a qual app pertence cada ícone e para abri-los para você. Ele nunca grava sua tela e nunca se conecta à internet, exceto para buscar atualizações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu需要辅助功能访问权限，以识别每个图标所属的App并替你打开图标。它绝不会录制你的屏幕，除检查更新外也绝不联网。"
          }
        }
      }
    },
    "Tansu only reads whether a camera or a microphone runs; it never records anything and needs no permission.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu erkennt nur, ob eine Kamera oder ein Mikrofon läuft; dabei wird nie etwas aufgezeichnet und keine Berechtigung benötigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu solo comprueba si una cámara o un micrófono están funcionando; nunca graba nada y no necesita ningún permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu vérifie seulement si une caméra ou un micro fonctionne ; il n’enregistre jamais rien et n’a besoin d’aucune autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu rileva solo se una fotocamera o un microfono è in funzione; non registra mai nulla e non richiede alcun permesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansuはカメラやマイクが動作しているかどうかを読み取るだけです。何も録画・録音せず、権限も必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu는 카메라나 마이크가 작동 중인지만 확인합니다. 아무것도 기록하지 않으며 권한도 필요하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu kijkt alleen of een camera of microfoon actief is; er wordt nooit iets opgenomen en er is geen toestemming nodig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu só verifica se uma câmera ou um microfone está funcionando; ele nunca grava nada e não precisa de permissão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu只会读取摄像头或麦克风是否正在运行；它绝不录制任何内容，也不需要任何权限。"
          }
        }
      }
    },
    "Tansu sees no icon to show yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu sieht noch kein Symbol, das angezeigt werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu aún no ve ningún icono que mostrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu ne voit encore aucune icône à afficher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu non vede ancora nessuna icona da mostrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansuには表示できるアイコンがまだ見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu가 아직 표시할 아이콘을 찾지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu ziet nog geen symbool om te tonen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu ainda não vê nenhum ícone para mostrar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu尚未发现可显示的图标。"
          }
        }
      }
    },
    "Tansu sorts the icons of your menu bar into drawers, each one a single icon. The menu bar keeps what you look at all day; everything else waits in a drawer, one click away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu sortiert die Symbole deiner Menüleiste in Schubladen, die jeweils als ein einziges Symbol erscheinen. Die Menüleiste behält, was du den ganzen Tag im Blick hast; alles andere wartet in einer Schublade, nur einen Klick entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu organiza los iconos de tu barra de menús en cajones, cada uno convertido en un solo icono. La barra de menús conserva lo que miras todo el día; lo demás espera en un cajón, a un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu range les icônes de votre barre des menus dans des tiroirs, chacun réduit à une seule icône. La barre des menus garde ce que vous regardez toute la journée ; tout le reste attend dans un tiroir, à un clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu riordina le icone della barra dei menu in cassetti, ognuno ridotto a una sola icona. La barra dei menu tiene ciò che guardi tutto il giorno; il resto aspetta in un cassetto, a portata di clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansuはメニューバーのアイコンを引き出しに整理し、それぞれの引き出しを1つのアイコンにまとめます。メニューバーには一日中見ているものだけが残り、それ以外はワンクリックで開ける引き出しの中で待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu는 메뉴 막대의 아이콘을 서랍으로 정리하고, 각 서랍을 아이콘 하나로 표시합니다. 메뉴 막대에는 하루 종일 보는 항목만 남고, 나머지는 클릭 한 번이면 열리는 서랍에서 기다립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu sorteert de symbolen in je menubalk in laden, die elk één symbool zijn. De menubalk houdt wat je de hele dag bekijkt; al het andere wacht in een lade, één klik verderop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu organiza os ícones da barra de menus em gavetas, cada uma reduzida a um único ícone. A barra de menus fica com o que você vê o dia todo; todo o resto espera em uma gaveta, a um clique de distância."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu会将菜单栏图标整理到抽屉中，每个抽屉只占一个图标。菜单栏只保留你整天都要看的项目，其余项目都在抽屉里，点按一下即可打开。"
          }
        }
      }
    },
    "Tansu works best from Applications: it can open at login and update itself there, and macOS 27 lets only apps there change the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu funktioniert am besten aus dem Ordner „Programme“: Dort kann Tansu bei der Anmeldung starten und sich selbst aktualisieren, und unter macOS 27 dürfen nur Apps dort die Menüleiste ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu funciona mejor desde la carpeta Aplicaciones: desde ahí puede abrirse al iniciar sesión y actualizarse, y macOS 27 solo permite que las apps de esa carpeta cambien la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu fonctionne mieux depuis le dossier Applications : il peut s’y ouvrir avec la session et se mettre à jour, et macOS 27 ne permet qu’aux apps qui s’y trouvent de modifier la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu funziona meglio dalla cartella Applicazioni: da lì può aprirsi al login e aggiornarsi automaticamente, e macOS 27 consente solo alle app che si trovano lì di modificare la barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansuは“アプリケーション”フォルダで使うのが最適です。そこならログイン時に開いたり自動でアップデートしたりでき、macOS 27ではそのフォルダ内のアプリしかメニューバーを変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu는 응용 프로그램 폴더에서 가장 잘 작동합니다. 그곳에서 로그인 시 열리고 스스로 업데이트할 수 있으며, macOS 27에서는 해당 폴더에 있는 앱만 메뉴 막대를 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu werkt het best vanuit de map 'Apps': daar kan Tansu openen bij het inloggen en zichzelf bijwerken, en in macOS 27 kunnen alleen apps in die map de menubalk wijzigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tansu funciona melhor na pasta Aplicativos: lá ele pode abrir no início da sessão e se atualizar, e o macOS 27 só permite que os apps dessa pasta alterem a barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu在“应用程序”文件夹中效果最佳：在那里它可以在登录时打开并自动更新，而且在macOS 27中，只有该文件夹中的App可以更改菜单栏。"
          }
        }
      }
    },
    "Tansu's icon, then your drawers in the order set in Drawers. Turn it off to place them yourself with a Command-drag.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Symbol von Tansu, dann deine Schubladen in der Reihenfolge unter „Schubladen“. Deaktiviere diese Option, um sie selbst durch Ziehen mit gedrückter Command-Taste zu platzieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono de Tansu y, después, tus cajones en el orden definido en Cajones. Desactívalo para colocarlos tú arrastrándolos con la tecla Comando pulsada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône de Tansu, puis vos tiroirs dans l’ordre défini dans Tiroirs. Désactivez l’option pour les placer vous-même en les faisant glisser avec la touche Commande enfoncée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icona di Tansu, poi i tuoi cassetti nell’ordine impostato in Cassetti. Disattiva l’opzione per posizionarli tu trascinandoli con il tasto Comando premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansuのアイコンに続けて、“引き出し”で設定した順に引き出しを並べます。オフにすると、Commandキーを押しながらドラッグして自分で配置できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tansu 아이콘 다음에 ‘서랍’에서 설정한 순서대로 서랍을 배치합니다. 끄면 Command-드래그로 직접 배치할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het symbool van Tansu, dan je laden in de volgorde die in 'Laden' is ingesteld. Schakel dit uit om ze zelf te plaatsen door te slepen met de Command-toets ingedrukt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone do Tansu e, depois, suas gavetas na ordem definida em Gavetas. Desative para posicioná-los você mesmo arrastando com a tecla Command pressionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先放Tansu图标，然后按“抽屉”中设定的顺序放置你的抽屉。关闭此选项后，可按住Command键拖移来自行放置。"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本"
          }
        }
      }
    },
    "The Mac runs on battery": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac läuft im Batteriebetrieb"
          }
        },
        "es": {
