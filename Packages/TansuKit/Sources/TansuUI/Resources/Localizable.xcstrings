    "They join Other as soon as the room runs out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wandern in die Schublade „Sonstiges“, sobald der Platz nicht mehr reicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasan al cajón “Otros” en cuanto se acaba el espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles rejoignent le tiroir « Autres » dès que la place manque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finiscono nel cassetto “Altro” non appena lo spazio si esaurisce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze gaan naar de lade 'Overig' zodra de ruimte op is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles vão para a gaveta “Outros” assim que o espaço acabar."
          }
        }
      }
    },
    "This drawer is empty.": {
