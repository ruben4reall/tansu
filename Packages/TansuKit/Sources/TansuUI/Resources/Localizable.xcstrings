          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tonalidade aparece enquanto a barra de menus não tiver um fundo próprio (Ajustes do Sistema > Barra de Menus)."
          }
        }
      }
    },
