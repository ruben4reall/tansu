    "%lld icons could not be moved. You can move them in Settings, Layout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Symbole konnten nicht bewegt werden. Du kannst sie in den Einstellungen unter „Layout“ bewegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido mover %lld iconos. Puedes moverlos en Ajustes > Disposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld icônes n’ont pas pu être déplacées. Vous pouvez les déplacer dans Réglages > Disposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile spostare %lld icone. Puoi spostarle in Impostazioni > Layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個のアイコンを移動できませんでした。設定の“レイアウト”で移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 %lld개를 이동할 수 없습니다. 설정의 ‘레이아웃’에서 이동할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld symbolen konden niet worden verplaatst. Je kunt ze verplaatsen in Instellingen onder 'Lay-out'."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover %lld ícones. Você pode movê-los em Ajustes > Layout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移动%lld个图标。你可以在设置的“布局”中移动它们。"
          }
        }
      }
    },
    "%lld icons do not fit beside the notch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Symbole passen nicht neben die Notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld iconos no caben junto al notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld icônes ne tiennent pas à côté de l’encoche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld icone non entrano accanto al notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個のアイコンがノッチの横に収まりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 %lld개가 노치 옆에 들어가지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld symbolen passen niet naast de notch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ícones não cabem ao lado do notch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有%lld个图标在刘海旁放不下。"
          }
        }
      }
    },
