          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n’est pas un fichier de réglages Tansu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non è un file di impostazioni di Tansu."
          }
        }
      }
    },
    "This version of macOS changed what Tansu relies on (%@). Everything stays in the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese macOS-Version hat geändert, worauf Tansu angewiesen ist (%@). Alles bleibt in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de macOS ha cambiado algo de lo que depende Tansu (%@). Todo se queda en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de macOS a modifié ce sur quoi Tansu s’appuie (%@). Tout reste dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di macOS ha modificato ciò su cui si basa Tansu (%@). Tutto resta nella barra dei menu."
