    "Without it, right-click any drawer for Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne das Symbol erreichst du die Einstellungen per Rechtsklick auf eine Schublade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin él, haz clic derecho en cualquier cajón para abrir los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans elle, cliquez avec le bouton droit sur un tiroir pour ouvrir les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza l’icona, fai clic con il tasto destro su un cassetto per aprire le impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示にした場合は、引き出しを右クリックして設定を開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 가리면 서랍을 오른쪽 클릭하여 설정을 열 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder dit symbool klik je met de rechtermuisknop op een lade voor de instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ele, clique com o botão direito em qualquer gaveta para abrir os Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏它后，可右键点按任意抽屉来打开设置。"
          }
        }
      }
    },
    "Your drawers and settings are replaced by the ones in the file. Export them first to keep a copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Schubladen und Einstellungen werden durch die aus der Datei ersetzt. Exportiere sie zuerst, um eine Kopie zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cajones y ajustes se sustituirán por los del archivo. Expórtalos antes para conservar una copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tiroirs et réglages sont remplacés par ceux du fichier. Exportez-les d’abord pour en garder une copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi cassetti e le tue impostazioni vengono sostituiti da quelli del file. Esportali prima per conservarne una copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き出しと設定がファイルの内容で置き換えられます。コピーを残すには、先に書き出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서랍과 설정이 파일의 내용으로 대치됩니다. 사본을 보관하려면 먼저 내보내십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je laden en instellingen worden vervangen door die in het bestand. Exporteer ze eerst om een kopie te bewaren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas gavetas e ajustes serão substituídos pelos do arquivo. Exporte-os antes para guardar uma cópia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的抽屉和设置将被文件中的内容替换。请先导出以保留副本。"
          }
        }
      }
    },
