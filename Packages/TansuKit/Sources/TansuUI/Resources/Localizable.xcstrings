          "stringUnit": {
            "state": "translated",
            "value": "macOS 26：Tansu会将图标移到隐形分隔条后面。"
          }
        }
      }
    },
    "macOS 27 lets only apps in the Applications folder change the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter macOS 27 dürfen nur Apps im Ordner „Programme“ die Menüleiste ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27 solo permite que las apps de la carpeta Aplicaciones cambien la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27 ne permet qu’aux apps du dossier Applications de modifier la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27 consente solo alle app nella cartella Applicazioni di modificare la barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27では、“アプリケーション”フォルダ内のアプリしかメニューバーを変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27에서는 응용 프로그램 폴더에 있는 앱만 메뉴 막대를 변경할 수 있습니다."
          }
        },
        "nl": {
