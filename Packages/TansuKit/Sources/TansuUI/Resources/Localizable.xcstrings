          }
        }
      }
    },
    "It starts as the setup you have now, and follows your changes while it is active.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es übernimmt deine aktuelle Konfiguration und folgt deinen Änderungen, solange es aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con tu configuración actual y sigue tus cambios mientras está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reprend votre configuration actuelle, puis suit vos modifications tant qu’il est actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte dalla configurazione attuale e segue le tue modifiche finché è attivo."
          }
        }
      }
    },
    "Its drawer is not in the current setup, so it does nothing for now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Schublade ist nicht Teil der aktuellen Konfiguration, daher bewirkt er vorerst nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cajón no está en la configuración actual, así que por ahora no hace nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tiroir ne fait pas partie de la configuration actuelle, il n’a donc aucun effet pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo cassetto non fa parte della configurazione attuale, quindi per ora non ha effetto."
          }
        }
      }
    },
    "Its profile no longer exists, so it does nothing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
