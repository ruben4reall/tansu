    "No profiles yet. Save your current setup to come back to it in one click, from Tansu's menu or a shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Profile. Sichere deine aktuelle Konfiguration, um mit einem Klick zu ihr zurückzukehren, über das Menü von Tansu oder einen Tastaturkurzbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay perfiles. Guarda tu configuración actual para volver a ella con un clic, desde el menú de Tansu o con un atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun profil pour l’instant. Enregistrez votre configuration actuelle pour y revenir en un clic, depuis le menu de Tansu ou avec un raccourci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun profilo. Salva la configurazione attuale per tornarci con un clic, dal menu di Tansu o con un’abbreviazione."
          }
        }
      }
    },
    "No triggers yet: start from one of these, or add your own.": {
