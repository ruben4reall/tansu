    "No drawers yet. Make one, or let Smart Sort propose them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Schubladen. Erstelle eine oder lass dir welche von Smart Sort vorschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay cajones. Crea uno o deja que Smart Sort te los proponga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun tiroir pour l’instant. Créez-en un, ou laissez Smart Sort vous en proposer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun cassetto. Creane uno o lascia che Smart Sort te li proponga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き出しはまだありません。作成するか、Smart Sortに提案させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 서랍이 없습니다. 서랍을 만들거나 Smart Sort가 제안하도록 하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen laden. Maak er een aan of laat Smart Sort ze voorstellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma gaveta ainda. Crie uma ou deixe o Smart Sort sugerir algumas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无抽屉。你可以创建一个，或让Smart Sort提供建议。"
          }
        }
      }
    },
    "No icon has a shortcut yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Symbol hat einen Tastaturkurzbefehl."
          }
