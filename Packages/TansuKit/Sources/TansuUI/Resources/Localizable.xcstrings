    },
    "The battery is at or below a level": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ladestand liegt bei einem Wert oder darunter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está en un nivel o por debajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est à un certain niveau ou moins"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La batteria è pari o inferiore a un livello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量が指定値以下である"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 잔량이 지정한 수준 이하"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De batterij staat op of onder een niveau"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria está em um nível ou abaixo dele"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池电量等于或低于指定值"
          }
        }
      }
    },
    "The camera or the microphone is in use": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera oder das Mikrofon wird verwendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara o el micrófono están en uso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra ou le micro est en cours d’utilisation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera o il microfono è in uso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラまたはマイクが使用中である"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 또는 마이크가 사용 중"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera of de microfoon is in gebruik"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera ou o microfone está em uso"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头或麦克风正在使用"
          }
        }
      }
    },
    "The short tour, Accessibility and Smart Sort, as on the first launch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kurze Einführung, die Bedienungshilfen und Smart Sort, wie beim ersten Start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La breve presentación, Accesibilidad y Smart Sort, como en el primer arranque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La visite guidée, l’autorisation Accessibilité et Smart Sort, comme au premier lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La breve presentazione, Accessibilità e Smart Sort, come al primo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回起動時と同じく、簡単な紹介、アクセシビリティ、Smart Sortを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 실행할 때처럼 간단한 소개, 손쉬운 사용, Smart Sort를 다시 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De korte rondleiding, Toegankelijkheid en Smart Sort, zoals bij de eerste keer openen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tour rápido, a Acessibilidade e o Smart Sort, como na primeira abertura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与首次启动时相同的简短介绍、辅助功能和Smart Sort。"
          }
        }
      }
    },
    "The tint shows while the menu bar has no background of its own (System Settings, Menu Bar).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tönung ist sichtbar, solange die Menüleiste keinen eigenen Hintergrund hat (Systemeinstellungen > Menüleiste)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tinte se muestra mientras la barra de menús no tiene fondo propio (Ajustes del Sistema > Barra de menús)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La teinte s’affiche tant que la barre des menus n’a pas son propre arrière-plan (Réglages Système > Barre des menus)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tinta appare quando la barra dei menu non ha uno sfondo proprio (Impostazioni di Sistema > Barra dei menu)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色合いは、メニューバーに独自の背景がないときに表示されます（システム設定＞“メニューバー”）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색조는 메뉴 막대에 자체 배경이 없을 때 표시됩니다(시스템 설정 > 메뉴 막대)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tint is zichtbaar zolang de menubalk geen eigen achtergrond heeft (Systeeminstellingen > 'Menubalk')."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tonalidade aparece enquanto a barra de menus não tiver um fundo próprio (Ajustes do Sistema > Barra de Menus)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当菜单栏没有自己的背景时会显示色调（“系统设置”中的“菜单栏”）。"
          }
        }
      }
    },
