    "Click a drawer in the menu bar to open it, and Tansu's own icon for all of them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf eine Schublade in der Menüleiste, um sie zu öffnen, und auf das Symbol von Tansu für alle Schubladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un cajón de la barra de menús para abrirlo, y en el icono de Tansu para verlos todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un tiroir dans la barre des menus pour l’ouvrir, et sur l’icône de Tansu pour les voir tous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un cassetto nella barra dei menu per aprirlo, e sull’icona di Tansu per vederli tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの引き出しをクリックすると開きます。Tansuのアイコンをクリックすると、すべての引き出しが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 서랍을 클릭하면 열리고, Tansu 아이콘을 클릭하면 모든 서랍이 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een lade in de menubalk om die te openen, en op het symbool van Tansu voor alle laden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma gaveta na barra de menus para abri-la, e no ícone do Tansu para ver todas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按菜单栏中的抽屉可将其打开，点按Tansu图标可查看所有抽屉。"
          }
        }
      }
    },
    "Click a drawer in the menu bar to open it, and search any icon with %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf eine Schublade in der Menüleiste, um sie zu öffnen, und suche mit %@ nach einem beliebigen Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un cajón de la barra de menús para abrirlo, y busca cualquier icono con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un tiroir dans la barre des menus pour l’ouvrir, et recherchez n’importe quelle icône avec %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un cassetto nella barra dei menu per aprirlo, e cerca qualsiasi icona con %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの引き出しをクリックすると開きます。%@で任意のアイコンを検索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 서랍을 클릭하면 열리고, %@(으)로 원하는 아이콘을 검색할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een lade in de menubalk om die te openen, en zoek elk symbool met %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma gaveta na barra de menus para abri-la, e busque qualquer ícone com %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按菜单栏中的抽屉可将其打开，按下%@可搜索任意图标。"
          }
        }
      }
    },
    "Click for every drawer. Right-click for more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke, um alle Schubladen zu sehen. Rechtsklick für weitere Optionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para ver todos los cajones, o clic derecho para más opciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour voir tous les tiroirs, ou avec le bouton droit pour plus d’options."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per vedere tutti i cassetti, o clic con il tasto destro per altre opzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするとすべての引き出しを表示、右クリックするとその他のオプションを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 서랍을 보려면 클릭하고, 더 많은 옵션을 보려면 오른쪽 클릭하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik voor alle laden. Klik met de rechtermuisknop voor meer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para ver todas as gavetas ou clique com o botão direito para mais opções."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以查看所有抽屉，右键点按以查看更多选项。"
          }
        }
      }
    },
