    "It starts as the setup you have now, and follows your changes while it is active.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es übernimmt deine aktuelle Konfiguration und folgt deinen Änderungen, solange es aktiv ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con tu configuración actual y sigue tus cambios mientras está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reprend votre configuration actuelle, puis suit vos modifications tant qu’il est actif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte dalla configurazione attuale e segue le tue modifiche finché è attivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het begint met je huidige configuratie en volgt je wijzigingen zolang het actief is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele começa com a configuração atual e acompanha suas alterações enquanto estiver ativo."
          }
        }
      }
    },
    "Its drawer is not in the current setup, so it does nothing for now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Schublade ist nicht Teil der aktuellen Konfiguration, daher bewirkt er vorerst nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cajón no está en la configuración actual, así que por ahora no hace nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son tiroir ne fait pas partie de la configuration actuelle, il n’a donc aucun effet pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo cassetto non fa parte della configurazione attuale, quindi per ora non ha effetto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lade ervan zit niet in de huidige configuratie, dus de trigger doet voorlopig niets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gaveta dele não está na configuração atual, então ele não faz nada por enquanto."
          }
        }
      }
    },
    "Its profile no longer exists, so it does nothing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Profil existiert nicht mehr, daher bewirkt er nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su perfil ya no existe, así que no hace nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son profil n’existe plus, il n’a donc aucun effet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo profilo non esiste più, quindi non ha effetto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het profiel ervan bestaat niet meer, dus de trigger doet niets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil dele não existe mais, então ele não faz nada."
          }
        }
      }
    },
