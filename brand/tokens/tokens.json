{
  "$description": "Tansu brand tokens: the single source of truth. brand/scripts/tokens/build.mjs writes brand/tokens/tokens.css from this file, the website copies that file with site/tools/sync-brand.mjs, and the app's Packages/TansuKit/Sources/TansuUI/Design/Theme.swift and Motion.swift hold the same values. Format: Design Tokens Community Group ($value, $type, $description).",
  "color": {
    "dark": {
      "night": { "$type": "color", "$value": "#0C0B0A", "$description": "Warm black: dark backgrounds" },
      "lacquer": { "$type": "color", "$value": "#17150F", "$description": "Raised dark surfaces: cards, panels, sidebars" },
      "rice": { "$type": "color", "$value": "#F5F1EA", "$description": "Text on dark" },
      "ash": { "$type": "color", "$value": "#9D968B", "$description": "Secondary text on dark" },
      "honey": { "$type": "color", "$value": "#FFB938", "$description": "The single accent on dark: a lamp inside a drawer" },
      "ember": { "$type": "color", "$value": "#FF8A1F", "$description": "The second stop of the glow; never text" }
    },
    "light": {
      "paper": { "$type": "color", "$value": "#FAF8F4", "$description": "Light backgrounds" },
      "ink": { "$type": "color", "$value": "#1C1A17", "$description": "Text on light" },
      "graphite": { "$type": "color", "$value": "#6E6A63", "$description": "Secondary text on light" },
      "deep-honey": { "$type": "color", "$value": "#8F5600", "$description": "The accent on light: links and buttons" },
      "hairline": { "$type": "color", "$value": "#DAD5CC", "$description": "Separators and outlines on light; never text" }
    }
  },
  "gradient": {
    "glow": {
      "$type": "gradient",
      "$value": [
        { "color": "{color.dark.honey}", "position": 0 },
        { "color": "{color.dark.ember}", "position": 1 }
      ],
      "$description": "The lamp's glow, honey to ember: the icon, the website hero and key moments only, never for text"
    }
  },
  "role": {
    "$description": "What each surface uses. Dark comes first: the website and the app's windows are dark; brand material on light uses the light roles.",
    "dark": {
      "background": { "$type": "color", "$value": "{color.dark.night}" },
      "surface": { "$type": "color", "$value": "{color.dark.lacquer}" },
      "text": { "$type": "color", "$value": "{color.dark.rice}" },
      "text-secondary": { "$type": "color", "$value": "{color.dark.ash}" },
      "separator": { "$type": "color", "$value": "#F5F1EA24", "$description": "Rice at 14% opacity: quiet, and visible on Night and on Lacquer" },
      "accent": { "$type": "color", "$value": "{color.dark.honey}" }
    },
    "light": {
      "background": { "$type": "color", "$value": "{color.light.paper}" },
      "surface": { "$type": "color", "$value": "#FFFFFF", "$description": "White: raised surfaces on Paper" },
      "text": { "$type": "color", "$value": "{color.light.ink}" },
      "text-secondary": { "$type": "color", "$value": "{color.light.graphite}" },
      "separator": { "$type": "color", "$value": "{color.light.hairline}" },
      "accent": { "$type": "color", "$value": "{color.light.deep-honey}" }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["-apple-system", "BlinkMacSystemFont", "Inter", "system-ui", "sans-serif"],
        "$description": "SF Pro through the system names on Apple devices, never embedded or shipped. Inter (OFL, self-hosted) is the only webfont, for every other system."
      }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "type": {
    "$description": "Size and line height in px; tracking in em, after SF Pro's two optical cuts: the text sizes (under 20 px) and the display sizes (20 px and up) each track tighter as they grow.",
    "display-1": { "$type": "typography", "$value": { "fontSize": "64px", "lineHeight": "68px", "fontWeight": 600, "letterSpacing": "-0.009em" } },
    "display-2": { "$type": "typography", "$value": { "fontSize": "56px", "lineHeight": "60px", "fontWeight": 600, "letterSpacing": "-0.005em" } },
    "display-3": { "$type": "typography", "$value": { "fontSize": "48px", "lineHeight": "52px", "fontWeight": 600, "letterSpacing": "-0.003em" } },
    "title-1": { "$type": "typography", "$value": { "fontSize": "32px", "lineHeight": "36px", "fontWeight": 600, "letterSpacing": "0.004em" } },
    "title-2": { "$type": "typography", "$value": { "fontSize": "28px", "lineHeight": "32px", "fontWeight": 600, "letterSpacing": "0.007em" } },
    "title-3": { "$type": "typography", "$value": { "fontSize": "22px", "lineHeight": "28px", "fontWeight": 600, "letterSpacing": "0.01em" } },
    "body-1": { "$type": "typography", "$value": { "fontSize": "17px", "lineHeight": "25px", "fontWeight": 400, "letterSpacing": "-0.022em" } },
    "body-2": { "$type": "typography", "$value": { "fontSize": "15px", "lineHeight": "22px", "fontWeight": 400, "letterSpacing": "-0.018em" } },
    "caption": { "$type": "typography", "$value": { "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400, "letterSpacing": "-0.012em" } }
  },
  "radius": {
    "s": { "$type": "dimension", "$value": "8px", "$description": "Buttons, small controls" },
    "m": { "$type": "dimension", "$value": "12px", "$description": "Inputs, tiles in a drawer" },
    "l": { "$type": "dimension", "$value": "20px", "$description": "Cards, previews" },
    "xl": { "$type": "dimension", "$value": "28px", "$description": "Large panels, hero frames" }
  },
  "space": {
    "$description": "4-point scale; the key is the multiple of 4.",
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" }
  },
  "motion": {
    "spring": {
      "drawer": {
        "$type": "spring",
        "$value": { "response": 0.32, "dampingFraction": 0.86 },
        "$description": "A drawer drops under its emoji: SwiftUI's spring(response:dampingFraction:); the CSS gets the same curve as a linear() easing and its settling time"
      }
    },
    "ease": {
      "sort": { "$type": "cubicBezier", "$value": [0.45, 0, 0.2, 1], "$description": "Icons slide to their drawer in Smart Sort" },
      "fade": { "$type": "cubicBezier", "$value": [0, 0, 0.58, 1], "$description": "The fade that replaces every movement under Reduce Motion (ease out)" }
    },
    "duration": {
      "fade": { "$type": "duration", "$value": "0.16s", "$description": "The Reduce Motion fade" }
    }
  }
}
